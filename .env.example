

LOG_LEVEL=info
HTTP_TIMEOUT_MS=15000
MAX_RETRIES=3
FIRST_RUN_CANDIDATE_LIMIT=20
FIRST_RUN_DELIVERY_LIMIT=10
HTTP_FETCHER_V2=true
SOURCE_FETCHER_PROFILE_DIR=./fetcher-profiles
SCHEDULER_V2=true
POLL_JITTER_RATIO=0.2

# DeepSeek (OpenAI-compatible). Set DEEPSEEK_API_KEY in .env (not committed).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_SMART=deepseek-reasoner
# important 后面再开这个LLM_REFINEMENT_ENABLED试试
LLM_REFINEMENT_ENABLED=false
LLM_REFINEMENT_THRESHOLD=6
DIGEST_MIN_IMPORTANCE=3
WATCHLIST_PATH=./config/watchlist.json
CLUSTERING_ENABLED=false
DIGEST_ENABLED=false
DIGEST_CRON=0 8 * * *
DIGEST_TIMEZONE=Asia/Shanghai
FEEDBACK_ENABLED=false
FEEDBACK_REVIEW_ENABLED=false
FEEDBACK_REVIEW_CRON=0 9 * * 0
EFFECTIVENESS_TRACKING_ENABLED=false
PRICE_SNAPSHOT_CRON=*/5 * * * *
