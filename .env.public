# Non-sensitive runtime configuration.
# Safe to commit. Safe for AI to read.
# Secrets (DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, DEEPSEEK_API_KEY) stay in .env.
#
# .env is loaded first; values here only apply when .env does not set the same key.
# So you can migrate gradually by deleting a key from .env and letting the default below take over.

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ---- HTTP fetching ----
HTTP_TIMEOUT_MS=15000
MAX_RETRIES=3
HTTP_FETCHER_V2=true
SOURCE_FETCHER_PROFILE_DIR=./fetcher-profiles

# ---- Scheduler / polling ----
SCHEDULER_V2=true
POLL_JITTER_RATIO=0.2
FIRST_RUN_CANDIDATE_LIMIT=20
FIRST_RUN_DELIVERY_LIMIT=10

# ---- DeepSeek (non-secret parts; API key stays in .env) ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_SMART=deepseek-reasoner

# ---- LLM refinement (v0.0.3: single-call impact extraction) ----
LLM_REFINEMENT_ENABLED=false
LLM_REFINEMENT_THRESHOLD=6

# ---- Watchlist / digest ----
WATCHLIST_PATH=./config/watchlist.json
DIGEST_MIN_IMPORTANCE=3
CLUSTERING_ENABLED=false
DIGEST_ENABLED=false
DIGEST_CRON=0 8 * * *
DIGEST_TIMEZONE=Asia/Shanghai

# ---- Feedback loop ----
FEEDBACK_ENABLED=false
FEEDBACK_REVIEW_ENABLED=false
FEEDBACK_REVIEW_CRON=0 9 * * 0

# ---- Effectiveness tracking ----
EFFECTIVENESS_TRACKING_ENABLED=false
PRICE_SNAPSHOT_CRON=*/5 * * * *
